#!/usr/bin/env perl
use warnings;
use strict;
use open qw(:locale);

use Getopt::Long qw();
use Data::Dumper qw();
use POSIX qw(round);

our $two;
our $max;
our $verbose = 0;
our $pow;

Getopt::Long::Configure('gnu_getopt');
Getopt::Long::GetOptions(
    "2|two" => \$two,
    "m|max=s" => \$max,
    "v|verbose+" => \$verbose,
) or die();

if (defined $max) {
    $max = eval($max);
} else {
    if ($two) {
        $max = 2 ** 64;
    } else {
        $max = 10000;
    }
}

if (!scalar @ARGV) {
    exit(0);
}
foreach my $arg (@ARGV) {
    $arg = eval($arg);
    approximate($arg);
}

sub approximate {
    my ($value) = @_;

    my $min_diff;
    my $min_abs_diff;
    my $denom = 2;
    my $pow = 1;

    my $step;
    if ($two) {
        $step = sub {
            $denom *= 2;
            $pow += 1;
        };
    } else {
        $step = sub {
            $denom += 1;
        };
    }

    for (; $denom <= $max; &$step()) {
        my $numer = $value * $denom;
        my $round_numer = round($numer);
        my $diff = ($numer - $round_numer);
        my $abs_diff = abs($diff);
        my $is_hit = !defined $min_abs_diff || $abs_diff < $min_abs_diff;
        if ($verbose) {
            print($is_hit ? "* " : "  ");
        }
        if ($is_hit) {
            $min_diff = $diff;
            $min_abs_diff = $abs_diff;
        }
        if ($verbose || $is_hit) {
            if ($two) {
                printf("%20d/2**%-20d (%g)\n", $round_numer, $pow, $diff);
            } else {
                printf("%20d/%-20d (%g)\n", $round_numer, $denom, $diff);
            }
        }
        if (!$diff) {
            return;
        }
    }
}
